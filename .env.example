# Adzuna API credentials — register at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# USAJobs API credentials — register at https://developer.usajobs.gov/APIRequest/
# USAJOBS_USER_AGENT_EMAIL must be the exact email used to request the key
# (USAJobs uses it as the User-Agent header, not the key itself, for auth).
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/jobmarket

# Optional: separate database for running integration tests
# TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/jobmarket_test

# Ingestion politeness / budget controls
ADZUNA_MIN_REQUEST_INTERVAL_SECONDS=1.5
ADZUNA_MONTHLY_CALL_BUDGET=1000
USAJOBS_MIN_REQUEST_INTERVAL_SECONDS=1.0
