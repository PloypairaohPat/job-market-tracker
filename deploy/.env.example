# Server .env for the production stack (docs/deploy.md). Copy to the REPO
# ROOT as .env (bootstrap.sh does it with mode 600) and edit with nano.
# Placeholders only -- never commit the real file. Use long random
# passwords made of letters and digits (they go into connection URLs, and
# Metabase rejects common ones):
#   openssl rand -hex 24

# --- Postgres ---------------------------------------------------------------
POSTGRES_PASSWORD=
# Metabase's own app database (role metabase_app, database metabase_app)
METABASE_APP_DB_PASSWORD=
# Database the pipeline and dashboards use. Leave unset (= jobmarket);
# a name containing "demo" is only for testing the stack with demo data.
# JOBMARKET_DB=jobmarket

# --- Public address -----------------------------------------------------------
# Caddy site address: a domain you control gets automatic HTTPS.
# ":80" = plain HTTP, for testing only.
SITE_ADDRESS=jobs.example.com
# The URL people will use (Metabase builds public links from it)
MB_SITE_URL=https://jobs.example.com
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# --- Metabase -----------------------------------------------------------------
METABASE_ADMIN_EMAIL=you@example.com
METABASE_ADMIN_PASSWORD=
# read-only role the dashboards query through (src/dashboard/reader_role.py)
METABASE_READER_PASSWORD=
# Java heap for a 4 GB server
METABASE_JAVA_HEAP=1536m

# --- Job sources (same as the laptop) -----------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=
ADZUNA_MIN_REQUEST_INTERVAL_SECONDS=1.5
ADZUNA_MONTHLY_CALL_BUDGET=1000
ADZUNA_MONTHLY_RESERVE=25
USAJOBS_MIN_REQUEST_INTERVAL_SECONDS=1.0

# --- Monitoring and backups ---------------------------------------------------
# Optional dead-man's switch: pinged after every daily run (empty = off)
HEALTHCHECK_PING_URL=
# Where deploy/backup.sh writes nightly dumps (on the server)
BACKUP_DIR=/var/backups/jobmarket
